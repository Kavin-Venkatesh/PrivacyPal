<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb hooks for checking features on a device. Never ships in release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name=".debug.MonitorDebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.privacypal.app.debug.MONITORS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
